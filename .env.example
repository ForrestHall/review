# Public site URL (no trailing slash)
# Use your Railway URL during testing, then your custom domain at launch.
NEXT_PUBLIC_SITE_URL=https://rvwarrantyreview.com

# Optional: override domain used in copy/metadata
# NEXT_PUBLIC_SITE_DOMAIN=rvwarrantyreview.com

# Persistent storage for owner-submitted reviews (Railway Volume mount path)
# Create a Volume in Railway, mount at /data, then set:
# DATA_DIR=/data

# Google Analytics 4 measurement ID. Defaults to G-RMSCHQPTV5; set to override.
# NEXT_PUBLIC_GA_ID=G-RMSCHQPTV5

# Google Search Console HTML-tag verification value (content attribute only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta (Facebook) Pixel — PageView on load; Lead fires from /find-coverage on success.
# NEXT_PUBLIC_META_PIXEL_ID=

# America's Warranty Advertiser API (AWI portal — server-side only).
# POST https://americaswarranty.com/api/insert/rv
# Required: firstName, lastName, email, phone, state (full name), rvClass, make,
# model, modelYear, purchasePrice; odometer when rvClass contains MTR.
# Lead Source comes from the Advertiser record (rvr).
# Without ARW_API_TOKEN, /find-coverage falls back to the hosted quote URL.
# ARW_API_TOKEN=
# ARW_API_BASE_URL=https://americaswarranty.com
# Optional class/make list host (defaults to americasrvwarranty.com)
# ARW_REFERENCE_BASE_URL=https://americasrvwarranty.com
